# =============================================================================
# image-resizer — toute la configuration passe par ces variables.
# Copiez ce fichier en .env et ne gardez que ce que vous changez.
# =============================================================================

# --- Sources (obligatoire : au moins une) ------------------------------------
# Une source = un nom, qui devient le premier segment de l'URL, et une cible :
# une adresse HTTP(S) ou un dossier local. Deux écritures possibles.
#
#   SOURCES='{"photos":"https://cdn.example.com","local":"/data/photos"}'
#   SOURCES='photos=https://cdn.example.com,local=/data/photos'
#
# Ou une variable par source, plus lisible dans un docker-compose :
SOURCE_DEMO=/app/public
#SOURCE_PHOTOS=https://cdn.example.com
#SOURCE_MEDIA=file:///data/media

# --- Réseau ------------------------------------------------------------------
#PORT=3000
#HOST=0.0.0.0
# Préfixe de montage, si le service ne vit pas à la racine du domaine.
#BASE_PATH=/images
# Chemin de la sonde de santé (jamais journalisée, jamais cachée).
#HEALTH_PATH=/health
# 'true', un nombre de sauts, ou une liste d'IP — cf. Express « trust proxy ».
#TRUST_PROXY=true

# --- Cache disque des originaux ----------------------------------------------
# Dossier où sont conservés les originaux téléchargés et les conversions
# coûteuses (HEIC, vignettes vidéo). Vide = aucune écriture disque.
#CACHE_DIR=/cache
#CACHE_ORIGINALS=true

# --- Transformation ----------------------------------------------------------
# Bornes appliquées aux dimensions demandées dans l'URL : une requête hors
# bornes est ramenée dans les bornes, jamais refusée.
#MIN_SIZE=1
#MAX_SIZE=2048
#MIN_QUALITY=10
#DEFAULT_QUALITY=80
# Ajustement par défaut : contain, cover, fill, inside, outside.
#DEFAULT_FIT=cover
#DEFAULT_FORMAT=jpeg
#ALLOWED_FORMATS=jpeg,png,webp,avif
# Autorise le preset _original___.ext, qui diffuse le fichier tel quel.
#ALLOW_ORIGINAL=true
# Sans dimension demandée, réduit tout de même les images au-delà de MAX_SIZE.
#AUTO_DOWNSCALE=true
# Retire EXIF, GPS et profils du fichier produit.
#STRIP_METADATA=true

# --- En-têtes de cache (le CDN est devant : ces valeurs comptent) -------------
#MAX_AGE=604800
#S_MAX_AGE=5184000
#STALE_WHILE_REVALIDATE=604800
# Durée de cache des réponses d'erreur, pour ne pas retaper la source à chaque
# visite d'une page qui référence une image absente.
#ERROR_MAX_AGE=60
# Remplace entièrement l'en-tête calculé à partir des quatre valeurs ci-dessus.
#CACHE_CONTROL=public, max-age=31536000, immutable
# Origine autorisée pour le CORS. Vide = aucun en-tête CORS.
#CORS_ORIGIN=*

# --- Amont HTTP --------------------------------------------------------------
#FETCH_TIMEOUT=15000
#FETCH_USER_AGENT=image-resizer
#MAX_INPUT_BYTES=67108864

# --- Charge ------------------------------------------------------------------
# Transformations simultanées au-delà desquelles le service répond 503 plutôt
# que de s'écrouler. Par défaut : le nombre de cœurs.
#MAX_CONCURRENCY=4
#RETRY_AFTER=2
# Réglages internes de sharp : 0 = valeur automatique, mémoire en Mio.
#SHARP_CONCURRENCY=0
#SHARP_CACHE_MEMORY=50

# --- HEIC / HEVC (photos iPhone) ---------------------------------------------
# Les binaires précompilés de sharp ne décodent pas le HEVC : la conversion
# passe par heif-convert, présent dans l'image Docker.
#HEIC_ENABLED=true
#HEIC_COMMAND=heif-convert
#HEIC_MAX_CONCURRENCY=2
#HEIC_TIMEOUT=30000

# --- Vignettes vidéo (optionnel, nécessite ffmpeg dans l'image) ---------------
# Activé, /source/clip.mp4.jpg extrait une image du film et la traite comme
# n'importe quelle image. L'image publiée n'embarque pas ffmpeg : reconstruire
# avec --build-arg INSTALL_FFMPEG=true.
#VIDEO_POSTER_ENABLED=false
#VIDEO_POSTER_COMMAND=ffmpeg
#VIDEO_POSTER_EXTENSIONS=mp4,mov,webm,m4v,mkv,avi
#VIDEO_POSTER_SEEK=1
#VIDEO_POSTER_WIDTH=1280
#VIDEO_POSTER_TIMEOUT=30000

# --- Journalisation ----------------------------------------------------------
# Format morgan (combined, common, dev, short, tiny) ou 'off'.
#LOG_FORMAT=tiny
#LOG_LEVEL=info

# --- Docker uniquement -------------------------------------------------------
#PUID=1000
#PGID=1000
#PORT_HOST=3000
#TZ=Europe/Paris
